# ==============================================
# ISA Link — Environment Variables
# Copy this file to .env and fill in values
# ==============================================

# Database (PostgreSQL required)
DATABASE_URL="postgresql://postgres:password@localhost:5432/isa_link"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Safe Browsing API (optional — moderation degrades gracefully without it)
GOOGLE_SAFE_BROWSING_API_KEY=""

# Admin Seed (used by: npm run db:seed)
ADMIN_SEED_EMAIL="admin@isa-link.org"
ADMIN_SEED_PASSWORD="Admin@ISA2026!"

# Server port
PORT=3000
